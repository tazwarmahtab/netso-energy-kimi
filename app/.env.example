# Netso Energy — environment template
# Do NOT put Notion tokens or other private CRM credentials in VITE_* variables.
# Browser bundles are public.

# Durable lead intake endpoint (same-origin path or https URL, no query/hash).
# Local: run `node scripts/lead-api-dev.mjs` then use /api/leads (Vite proxies to :3010).
# Production/Preview: Vercel serves api/leads.js at /api/leads.
VITE_LEAD_INTAKE_ENDPOINT=/api/leads

# Optional public CDN origin for large media trees (Phase 4).
# VITE_NETSO_ASSET_BASE_URL=
